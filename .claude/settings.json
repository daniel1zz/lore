{
  "env": {
    "CLAUDE_AC_TRACE_BYPASS": "1"
  },
  "permissions": {
    "deny": ["Agent(general-purpose)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/assets/hooks/pre-subagent-gate.mjs" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/assets/hooks/pre-no-general-agent-gate.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/assets/hooks/pre-dispatch-isolation-gate.mjs" }
        ]
      }
    ]
  }
}
