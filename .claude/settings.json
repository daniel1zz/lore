{
  "env": {
    "CLAUDE_AC_TRACE_BYPASS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g1-spec-create.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g2-spec-promote.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g3-plan-promote.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g4-task-claim.sh" }
        ]
      },
      {
        "matcher": "mcp__.*lore_create.*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g1-spec-create.sh" }
        ]
      },
      {
        "matcher": "mcp__.*lore_claim.*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g4-task-claim.sh" }
        ]
      },
      {
        "matcher": "mcp__.*lore_approve.*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g2-spec-promote.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g3-plan-promote.sh" }
        ]
      },
      {
        "matcher": "mcp__.*lore_set.*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g2-spec-promote.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/g3-plan-promote.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/assets/hooks/pre-subagent-gate.mjs" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/assets/hooks/pre-no-general-agent-gate.mjs" }
        ]
      }
    ]
  }
}
