{
  "name": "lore-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "bin": { "lore": "dist/lore" },
  "scripts": {
    "dev": "bun run packages/lore/src/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun run test:vitest && bun run test:bun",
    "test:vitest": "NODE_OPTIONS=--max-old-space-size=2048 bunx vitest run",
    "test:bun": "cd packages/lore && bun test --timeout 30000 .bun.test",
    "test:changed": "bun scripts/changed-tests.ts",
    "test:watch": "bunx vitest",
    "typecheck": "bun run typecheck:core && bun run typecheck:lore && bun run typecheck:lore-tests && bun run typecheck:scripts && bun run typecheck:dashboard",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:lore": "tsc --noEmit -p packages/lore/tsconfig.json",
    "typecheck:lore-tests": "tsc --noEmit -p packages/lore/tsconfig.tests.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json",
    "typecheck:dashboard": "bun run --filter '@lore/dashboard' typecheck",
    "check:ordinal-sites": "node scripts/check-ordinal-write-sites.mjs"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
