dist/
node_modules/
# @tanstack/router-cli codegen scratch. `bun run typecheck` and the dashboard
# prebuild both invoke the generator, which writes here, so leaving it
# untracked-but-not-ignored made every local typecheck/build dirty the tree.
# That had teeth: `lore evidence --result pass` and `lore release` refuse on a
# dirty tree and their remedy text says to `git add` the offending path, i.e.
# it instructs committing generated output; and SPEC-134's `build_dirty` reads
# true for every local build. Measured 2026-08-17 in a fresh worktree
# (.tanstack/tmp/), where the generator writes on first run.
packages/dashboard/.tanstack/
# .lore/ contents are local (db, WAL, key) EXCEPT export-index.json —
# SPEC-021: the corpus↔file ID map is git-tracked and team-shared.
# audit-anchor.json (SPEC-079 G3) is the SAME kind of exception — the
# external trust root for `lore audit --verify`'s tamper-detection chain
# must be git-tracked so a chain rewrite before the anchor point is
# detectable from git history, not just from the (also-rewritable) DB file.
.lore/*
!.lore/export-index.json
!.lore/audit-anchor.json
# autonomy-mirror.json (AC-AU-9) is the git-tracked projection of the governed autonomy threshold record + the decision
# chain head, written by `bun run mirror:export`; the pushed-heads ledger beside the DB stays local on purpose.
!.lore/autonomy-mirror.json
# D14 (spec-context-fragments-config-driven-layered-rule-injection): project fragments are git-shared.
!.lore/context/
# This repo's dogfood config is a versioned repo fact: scripts/check-shipped-defaults.ts measures it, and an
# untracked copy made that check pass vacuously in every worktree, clone and CI run (#223).
!.lore/config.yaml
*.db
*.sqlite
.DS_Store
coverage/

.agent-worktree-marker
docs/.docman/
packages/*/node_modules
packages/*/dist
.lore/local-key

# SPEC-048: npm publish pipeline staging + artifact output — never committed.
dist-npm/

# spec-dashboard-production-packaging-one-command-lore-dashboard, DD-1 git
# contract: content churns with every hashed vite build filename, unlike the
# committed assets-manifest.ts precedent. Regenerated by `bun run build`
# (scripts/build.ts); consumed only via the committed dynamic-import loader
# packages/lore/src/adapters/http/dashboard-assets-loader.ts.
packages/lore/src/generated/dashboard-assets.ts

# spec-oracle-exclusivity-in-a-shared-checkout-a-mirror-check, D4: the ONLY
# sanctioned home for hand-written probe / negative-control artifacts (a
# deliberately-broken .ts, a fixture tree, etc). Sits outside every
# `bun run typecheck:*` project's `include` glob (asserted from both sides by
# scripts/tests/scratch-namespace.test.ts) -- never write a probe into a real
# typechecked glob, even transiently, even with cleanup: doing so reds every
# concurrent `typecheck` in this checkout for the duration of the write.
.scratch/

# Per-worktree scope file written by lore claim / anchor declare|add|rm / release and read by the pre-edit-anchor-gate hook
.lore-scope.json
