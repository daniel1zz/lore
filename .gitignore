dist/
node_modules/
# .lore/ contents are local (db, WAL, key) EXCEPT export-index.json —
# SPEC-021: the corpus↔file ID map is git-tracked and team-shared.
# audit-anchor.json (SPEC-079 G3) is the SAME kind of exception — the
# external trust root for `lore audit --verify`'s tamper-detection chain
# must be git-tracked so a chain rewrite before the anchor point is
# detectable from git history, not just from the (also-rewritable) DB file.
.lore/*
!.lore/export-index.json
!.lore/audit-anchor.json
*.db
*.sqlite
.DS_Store
coverage/

.agent-worktree-marker
docs/.docman/
packages/*/node_modules
packages/*/dist
.lore/local-key

# SPEC-048: npm publish pipeline staging + artifact output — never committed.
dist-npm/

# spec-dashboard-production-packaging-one-command-lore-dashboard, DD-1 git
# contract: content churns with every hashed vite build filename, unlike the
# committed assets-manifest.ts precedent. Regenerated by `bun run build`
# (scripts/build.ts); consumed only via the committed dynamic-import loader
# packages/lore/src/adapters/http/dashboard-assets-loader.ts.
packages/lore/src/generated/dashboard-assets.ts
