{
  "include": ["scripts/**/*"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "noEmit": true,
    "paths": {
      "@lore/core": ["./packages/core/src/index.ts"],
      "@lore/core/node": ["./packages/core/src/node.ts"]
    }
  }
}
