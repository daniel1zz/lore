#!/bin/sh
# Corpus conformance gate (lore-doctor recurrence prevention, 2026-07-14).
# Blocks push when the `lore` binary issuing every verdict below was not built
# from this source (spec-bootstrap-fixpoint-integrity-binary-provenance-an-anchor,
# AC-BFI-3), when tree structure or code anchors drift from the corpus blueprint,
# when the audit hash chain has been tampered with (SPEC-080 G5), when the
# root PRD outline exceeds its tiered char budgets (SPEC-080 Phase 3, armed
# 2026-07-26 after 5 observed clean plan-closes; threshold was 2), or when a
# project memory file (CLAUDE.md) exceeds its corpus-governed line/byte
# ceiling (AC-CMC-4, spec-project-claude-md-content-contract-governance-injected),
# or when anchor coverage decays in either direction — a live spec declaring no
# code anchors and carrying no ledger row, or a ledger row outliving the debt it
# names (AC-BFI-9, same spec as the provenance step).
# Fail-open contract (same as g1-g4 gate shims): no lore binary / no .lore -> allow.
# Bypass: git push --no-verify
command -v lore >/dev/null 2>&1 || exit 0
[ -d "$(git rev-parse --show-toplevel)/.lore" ] || exit 0
export CLAUDECODE=1
# Provenance runs FIRST: every check below is only as trustworthy as the binary
# issuing it. Unlike the four `-ne 0` blocks that follow, this one dispatches on
# the exact code, because 3 (built from a different commit) and 4 (compiled with
# no build commit at all) need different remedies and collapsing them would give
# a build defect the advice for a stale build. An npm-installed `lore` whose
# build commit is unknown to this repo exits 0 with `skipped`, so a consumer is
# never blocked by this check.
lore status --check-binary-provenance
code=$?
case "$code" in
  0) ;;
  3)
    echo "pre-push: binary provenance check failed (exit $code) — this \`lore\` was built from a different commit than the tree you are pushing, so every corpus verdict it issues is untrustworthy; rebuild with \`bun run build\` or push with --no-verify" >&2
    exit 1
    ;;
  4)
    echo "pre-push: binary provenance check failed (exit $code) — this compiled \`lore\` carries no build commit at all, which is a build defect; rebuild with \`bun run build\` and check scripts/build.ts's \`define\` injection, or push with --no-verify" >&2
    exit 1
    ;;
  *)
    echo "pre-push: binary provenance check failed (exit $code) — \`lore status --check-binary-provenance\` could not classify this binary (a \`lore\` predating the flag exits 2 on the unknown flag); upgrade or rebuild \`lore\`, diagnose with that command, or push with --no-verify" >&2
    exit 1
    ;;
esac
lore status --check-tree --check-drift
code=$?
if [ "$code" -ne 0 ]; then
  echo "pre-push: lore corpus check failed (exit $code) — fix drift (lore status --check-tree --check-drift) or push with --no-verify" >&2
  exit 1
fi
lore audit --verify
code=$?
if [ "$code" -ne 0 ]; then
  echo "pre-push: audit chain verification failed (exit $code) — the audit hash chain or anchor is broken; diagnose with \`lore audit --verify\` or push with --no-verify" >&2
  exit 1
fi
lore status --check-prd-budget
code=$?
if [ "$code" -ne 0 ]; then
  echo "pre-push: PRD outline budget check failed (exit $code) — tighten the over-budget section(s) (lore status --check-prd-budget) or push with --no-verify" >&2
  exit 1
fi
# Anchor-coverage ratchet, LAST because it is the only step here that is not the
# `lore` binary: it is a REPO SCRIPT (scripts/check-anchor-coverage.ts), so the
# fail-open preamble above — which gates on `lore` and `.lore/` — does not cover
# it. A third-party project that installed this hook via `lore setup --project`
# has no such script and no ledger to check, so presence of the script AND of
# `bun` is the guard. ⛔ That guard is an `if`, never a `|| exit 0`: a missing
# checker must not short-circuit a hook that has already passed five real checks.
# Like the provenance step, it dispatches on the EXACT code rather than `-ne 0`:
# the checker exits 1 for a repo-invariant failure (a ledger/anchor mismatch the
# pusher must resolve) and 2 when the scan itself could not complete (unreadable
# ledger, corpus read error, or its two population predicates disagreeing) —
# collapsing them would hand a broken scan the advice for a real violation.
anchor_coverage_checker="$(git rev-parse --show-toplevel)/scripts/check-anchor-coverage.ts"
if [ -f "$anchor_coverage_checker" ] && command -v bun >/dev/null 2>&1; then
  bun "$anchor_coverage_checker"
  code=$?
  case "$code" in
    0) ;;
    1)
      echo "pre-push: anchor-coverage ratchet failed (exit $code) — the report above names every offending spec: an unanchored live spec needs \`lore anchor add <spec> <path#Symbol>\` or a row in scripts/anchor-coverage-ledger.json, and a ledger row whose spec is now anchored must be deleted; or push with --no-verify" >&2
      exit 1
      ;;
    *)
      echo "pre-push: anchor-coverage ratchet could not complete its scan (exit $code) — this is a checker/ledger defect, not unanchored specs; diagnose with \`bun scripts/check-anchor-coverage.ts\`, or push with --no-verify" >&2
      exit 1
      ;;
  esac
fi

# Autonomy threshold integrity (AC-AU-9, ADR D8). Two checks, both on the `lore` binary:
#  1. the governed threshold record still matches its decision-log chain — an edit made outside lore makes every
#     autonomy class escalate, and a push that ships that state is refused (`lore status --check-autonomy-thresholds`);
#  2. the local decision log still REPRODUCES every chain head this machine already pushed. A database rewritten from
#     scratch (record edited AND chain rebuilt to match) verifies clean on its own; it cannot reproduce a head that was
#     hashed over the rows it no longer has. `--record` notes the current head as pushed after a clean check, in the
#     machine-local ledger `.lore/autonomy-pushed-heads.json` (never git-tracked: another machine's log has another
#     history). A lore binary that predates the verbs exits 2 on the unknown command, which blocks like any failure.
lore status --check-autonomy-thresholds
code=$?
if [ "$code" -ne 0 ]; then
  echo "pre-push: autonomy threshold integrity check failed (exit $code) — the threshold record was edited outside lore (lore status --check-autonomy-thresholds names it; the human restores trust by answering the question lore pending --ask writes, in the agent session), or push with --no-verify" >&2
  exit 1
fi
lore autonomy verify-pushed-heads --record
code=$?
if [ "$code" -ne 0 ]; then
  echo "pre-push: decision-log head check failed (exit $code) — the local decision log does not reproduce a chain head already pushed (the database was rewritten); diagnose with \`lore autonomy verify-pushed-heads\`, or push with --no-verify" >&2
  exit 1
fi
exit 0
