{
  "doc_type": "spec",
  "kind": "domain-overview",
  "version": 1,
  "fields": {
    "type": "object",
    "required": ["summary", "glossary", "entities", "invariants"],
    "properties": {
      "summary": {
        "type": "string",
        "title": "Summary",
        "minLength": 1,
        "description": "What this domain is and what it covers, in a short paragraph."
      },
      "boundaries": {
        "type": "object",
        "title": "Boundaries",
        "properties": {
          "covers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "excludes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      },
      "glossary": {
        "type": "array",
        "title": "Glossary",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["term", "definition"],
          "properties": {
            "term": { "type": "string", "minLength": 1 },
            "definition": { "type": "string", "minLength": 1 }
          }
        }
      },
      "entities": {
        "type": "array",
        "title": "Entities and relationships",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "relations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      },
      "workflows": {
        "type": "array",
        "title": "Workflows",
        "items": {
          "type": "object",
          "required": ["name", "steps"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      },
      "invariants": {
        "type": "array",
        "title": "Invariants",
        "minItems": 1,
        "description": "Statements that always hold in this domain.",
        "items": { "type": "string", "minLength": 1 }
      },
      "sources": {
        "type": "array",
        "title": "Sources",
        "description": "Where each claim here comes from (a document slug, a file path, a command).",
        "items": { "type": "string", "minLength": 1 }
      },
      "related": {
        "type": "array",
        "title": "Related documents",
        "x-ref-list": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "dimensions": [
    { "id": "boundary", "question": "What does this overview cover and exclude, and who owns what lies just outside it?" },
    { "id": "source-of-truth", "question": "Where does the authoritative version of each fact live, so this overview does not become a second copy?" },
    { "id": "staleness", "question": "How will a reader know when a statement here has stopped being true, and who updates it?" },
    { "id": "unseen-inputs", "question": "Which parts of the domain are not observable from the corpus or code (people, external systems, conventions) and how are they marked?" }
  ],
  "checks": ["refs-resolve"],
  "render": [
    { "heading": "Summary", "fields": ["summary"] },
    { "heading": "Boundaries", "fields": ["boundaries"] },
    { "heading": "Glossary", "fields": ["glossary"] },
    { "heading": "Entities and relationships", "fields": ["entities"] },
    { "heading": "Workflows", "fields": ["workflows"] },
    { "heading": "Invariants", "fields": ["invariants"] },
    { "heading": "Sources", "fields": ["sources"] },
    { "heading": "Related documents", "fields": ["related"] }
  ]
}
