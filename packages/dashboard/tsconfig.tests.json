{
  // reason: `extends` does NOT reset `exclude` — tsconfig.json's own
  // `exclude: ["node_modules", "dist", "tests"]` is inherited verbatim, and
  // `exclude` filters `include`, so without this override this project resolved
  // ZERO files under tests/** despite declaring "tests/**/*" in `include` (measured
  // 2026-08-07: `bunx tsc -p packages/dashboard/tsconfig.tests.json --noEmit
  // --listFilesOnly` returned 648 files, 0 under packages/dashboard/tests/). Its
  // exit 0 was the exit code of checking nothing. This project's own `exclude`
  // must NOT swallow "tests" the way the base config's does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*"],
  // "tests/e2e" excluded: its two `.ts` helpers (mint-machine-dashboard-key.ts,
  // multi-project-server.ts) import from packages/lore/src/**, outside this
  // project's rootDir "." — tsc then drags 100+ cross-package files into the
  // program and reports every one as TS6059 "not under rootDir" (measured
  // 2026-08-07: 102 TS6059 + 7 TS2307 + 8 TS2868, zero of it a fixture defect).
  // Playwright specs are `.pw.ts` and run under Playwright's own pipeline, not
  // this project. ⛔ Named residual: with this exclude, those two helper .ts
  // files are typechecked by NOTHING in `bun run typecheck` (not a regression —
  // the whole tests tree was excluded before this project existed — but a real
  // remaining blind spot). Closing it needs a separate e2e project without
  // `rootDir`; out of scope here.
  "exclude": ["node_modules", "dist", "tests/e2e"]
}
