{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // reason: @lore/core resolves to source (packages/core/src/index.ts). The barrel is
    // browser-safe (no fs/path/os — those live behind the @lore/core/node subpath, never
    // imported here), but config.ts::resolveSyncCredentials references the `process` global
    // (process.env[envVarName]) for type-checking purposes even though the dashboard never
    // calls that function. Adding "node" here resolves the `process` global type only.
    // See packages/core/src/CLAUDE.md "Browser safety" invariant.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      // reason: `paths` in a child config REPLACES the base's; repeat the workspace entries
      // so @lore/core resolves to this checkout's own source, not a node_modules symlink.
      "@lore/core": ["../core/src/index.ts"],
      "@lore/core/node": ["../core/src/node.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
